#!/usr/bin/env bash
set -euo pipefail

APP="codey"
REPO="fares-moustafa/Codey-Community"
INSTALL_DIR="${CODEY_INSTALL_DIR:-$HOME/.codey/bin}"
VERSION="${VERSION:-}"
NO_MODIFY_PATH=false
SKIP_CHECKSUM="${CODEY_SKIP_CHECKSUM:-false}"

MUTED='\033[0;2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[38;5;214m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat <<EOF
Codey CLI Installer

Install the AI coding agent for the terminal.

Usage: install [options]

Options:
    -h, --help              Show this help
    -v, --version <ver>     Install a specific version (e.g., 3.6.0)
    -b, --binary <path>     Install from a local binary
        --no-modify-path    Don't modify shell config files
        --dir <path>        Install directory (default: ~/.codey/bin)

Environment:
    VERSION=x.y.z           Same as --version (used by 'codey upgrade')
    CODEY_INSTALL_DIR=path  Override the install directory
    CODEY_SKIP_CHECKSUM=1   Skip SHA256 verification (not recommended)

Examples:
    curl -fsSL https://codeyai.space/install | bash
    curl -fsSL https://codeyai.space/install | bash -s -- --version 3.6.0
    ./install --binary ./codey
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -v|--version)
            [ -n "${2:-}" ] || { echo -e "${RED}--version requires a value${NC}" >&2; exit 1; }
            VERSION="$2"; shift 2 ;;
        -b|--binary)
            [ -n "${2:-}" ] || { echo -e "${RED}--binary requires a value${NC}" >&2; exit 1; }
            BINARY_PATH="$2"; shift 2 ;;
        --no-modify-path) NO_MODIFY_PATH=true; shift ;;
        --dir)
            [ -n "${2:-}" ] || { echo -e "${RED}--dir requires a value${NC}" >&2; exit 1; }
            INSTALL_DIR="$2"; shift 2 ;;
        *) echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2; shift ;;
    esac
done

detect_platform() {
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
        Darwin*) os="darwin" ;;
        Linux*)  os="linux" ;;
        MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    case "$arch" in
        aarch64|arm64) arch="arm64" ;;
        x86_64|amd64)  arch="x64" ;;
        *) echo -e "${RED}Unsupported architecture: $arch${NC}"; exit 1 ;;
    esac

    # Under Rosetta 2 an x64 shell should install the native arm64 build.
    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
        rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
        if [ "$rosetta_flag" = "1" ]; then
            arch="arm64"
        fi
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
        if [ -f /etc/alpine-release ]; then
            is_musl=true
        elif command -v ldd >/dev/null 2>&1; then
            if ldd --version 2>&1 | grep -qi musl; then
                is_musl=true
            fi
        fi
    fi

    # Older x64 CPUs without AVX2 need the baseline build.
    needs_baseline=false
    if [ "$arch" = "x64" ]; then
        if [ "$os" = "linux" ] && [ -f /proc/cpuinfo ]; then
            if ! grep -qi avx2 /proc/cpuinfo 2>/dev/null; then
                needs_baseline=true
            fi
        fi
        if [ "$os" = "darwin" ]; then
            avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
            if [ "$avx2" != "1" ]; then
                needs_baseline=true
            fi
        fi
        if [ "$os" = "windows" ]; then
            ps='(Add-Type -MemberDefinition "[DllImport(""kernel32.dll"")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)'
            out=""
            if command -v powershell.exe >/dev/null 2>&1; then
                out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
            elif command -v pwsh >/dev/null 2>&1; then
                out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
            fi
            out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
            if [ "$out" != "true" ] && [ "$out" != "1" ]; then
                needs_baseline=true
            fi
        fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
        target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
        target="$target-musl"
    fi

    archive_ext=".tar.gz"
    [ "$os" != "linux" ] && archive_ext=".zip"

    echo "$os|$arch|$target|$archive_ext"
}

IFS='|' read -r os arch target archive_ext <<< "$(detect_platform)"

if [ -n "${BINARY_PATH:-}" ]; then
    if [ ! -f "$BINARY_PATH" ]; then
        echo -e "${RED}Binary not found: $BINARY_PATH${NC}"
        exit 1
    fi
    specific_version="local"
else
    case "$target" in
        linux-arm64|linux-x64|linux-x64-baseline|linux-arm64-musl|linux-x64-musl|linux-x64-baseline-musl|darwin-arm64|darwin-x64|darwin-x64-baseline|windows-arm64|windows-x64|windows-x64-baseline) ;;
        *) echo -e "${RED}Unsupported platform target: $target${NC}"; exit 1 ;;
    esac

    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${RED}curl is required but not installed${NC}"
        exit 1
    fi

    # Resolve the version to install.
    if [ -z "$VERSION" ]; then
        echo -e "${MUTED}Fetching latest version...${NC}"
        release_json=$(curl -sfL --max-time 15 \
            -H "Accept: application/vnd.github+json" \
            -H "User-Agent: codey-installer" \
            "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null || true)
        VERSION=$(printf '%s\n' "$release_json" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -n 1)
        if [ -z "$VERSION" ]; then
            # API rate-limited or unreachable: install straight from the
            # /releases/latest/download alias, which never needs the API.
            echo -e "${MUTED}Could not reach the GitHub API, falling back to the latest release${NC}"
            VERSION="latest"
        else
            echo -e "${GREEN}Latest version: $VERSION${NC}"
        fi
    fi

    VERSION="${VERSION#v}"

    if [ "$VERSION" = "latest" ]; then
        VERSION=""
        DOWNLOAD_URL="https://github.com/$REPO/releases/latest/download/$APP-$target$archive_ext"
    else
        specific_version="$VERSION"
        DOWNLOAD_URL="https://github.com/$REPO/releases/download/v$VERSION/$APP-$target$archive_ext"
    fi
    FILENAME="$APP-$target$archive_ext"

    echo -e "${MUTED}Downloading $APP ${specific_version:-latest} for $target...${NC}"

fi

mkdir -p "$INSTALL_DIR"
binary_name="$APP"
[ "$os" = "windows" ] && binary_name="$APP.exe"
install_tmp="$INSTALL_DIR/.${binary_name}.new.$$"

cleanup() {
    [ -n "${tmp_dir:-}" ] && [ -d "$tmp_dir" ] && rm -rf "$tmp_dir"
    [ -f "$install_tmp" ] && rm -f "$install_tmp"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ -n "${specific_version:-}" ]; then
    installed_version=""
    if [ -x "$INSTALL_DIR/$binary_name" ]; then
        installed_version=$("$INSTALL_DIR/$binary_name" --version 2>/dev/null || true)
    elif command -v "$APP" >/dev/null 2>&1; then
        installed_version=$("$APP" --version 2>/dev/null || true)
    fi
    if [ "$installed_version" = "$specific_version" ]; then
        echo -e "${GREEN}Codey CLI v$specific_version is already installed${NC}"
        exit 0
    fi
fi

if [ -n "${BINARY_PATH:-}" ]; then
    cp "$BINARY_PATH" "$install_tmp"
else
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/${APP}_install.XXXXXX")

    if ! curl --fail --location --progress-bar --retry 3 --retry-delay 1 -o "$tmp_dir/$FILENAME" "$DOWNLOAD_URL"; then
        echo -e "${RED}Failed to download release asset:${NC}"
        echo -e "${MUTED}$DOWNLOAD_URL${NC}"
        exit 1
    fi

    echo ""
    # Verify the archive before extracting anything from it.
    if [ -n "${specific_version:-}" ]; then
        sums_url="https://github.com/$REPO/releases/download/v$specific_version/SHA256SUMS.txt"
    else
        sums_url="https://github.com/$REPO/releases/latest/download/SHA256SUMS.txt"
    fi
    if [ "$SKIP_CHECKSUM" != "1" ] && [ "$SKIP_CHECKSUM" != "true" ]; then
        if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
            echo -e "${RED}No SHA256 tool found (sha256sum or shasum required)${NC}"
            exit 1
        fi
        if ! curl -sfL --max-time 15 -o "$tmp_dir/SHA256SUMS.txt" "$sums_url"; then
            echo -e "${RED}Could not download SHA256SUMS.txt for this release${NC}"
            exit 1
        fi
        expected=$(awk -v file="$FILENAME" '$2 == file { print $1; exit }' "$tmp_dir/SHA256SUMS.txt")
        if ! printf '%s' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$'; then
            echo -e "${RED}No valid checksum was published for $FILENAME${NC}"
            exit 1
        fi
        if command -v sha256sum >/dev/null 2>&1; then
            actual=$(sha256sum "$tmp_dir/$FILENAME" | awk '{print $1}')
        else
            actual=$(shasum -a 256 "$tmp_dir/$FILENAME" | awk '{print $1}')
        fi
        if [ "$actual" != "$expected" ]; then
            echo -e "${RED}Checksum mismatch for $FILENAME${NC}"
            echo -e "${RED}  expected: $expected${NC}"
            echo -e "${RED}  actual:   $actual${NC}"
            exit 1
        fi
        echo -e "${GREEN}✓ Checksum verified${NC}"
    fi

    echo -e "${MUTED}Extracting...${NC}"
    if [ "$archive_ext" = ".tar.gz" ]; then
        command -v tar >/dev/null 2>&1 || { echo -e "${RED}tar is required${NC}"; exit 1; }
        tar -xzf "$tmp_dir/$FILENAME" -C "$tmp_dir"
    elif command -v unzip >/dev/null 2>&1; then
        unzip -qo "$tmp_dir/$FILENAME" -d "$tmp_dir"
    elif command -v tar >/dev/null 2>&1; then
        tar -xof "$tmp_dir/$FILENAME" -C "$tmp_dir"
    elif [ "$os" = "windows" ] && command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -Command "Expand-Archive -Force '$(cygpath -w "$tmp_dir/$FILENAME" 2>/dev/null || echo "$tmp_dir/$FILENAME")' '$(cygpath -w "$tmp_dir" 2>/dev/null || echo "$tmp_dir")'"
    else
        echo -e "${RED}Neither unzip nor tar found; cannot extract the archive${NC}"
        exit 1
    fi

    # The archive contains the binary at its root (codey / codey.exe).
    if [ -f "$tmp_dir/$APP" ]; then
        mv "$tmp_dir/$APP" "$install_tmp"
    elif [ -f "$tmp_dir/bin/$APP" ]; then
        mv "$tmp_dir/bin/$APP" "$install_tmp"
    elif [ -f "$tmp_dir/$APP.exe" ]; then
        mv "$tmp_dir/$APP.exe" "$install_tmp"
    elif [ -f "$tmp_dir/bin/$APP.exe" ]; then
        mv "$tmp_dir/bin/$APP.exe" "$install_tmp"
    else
        echo -e "${RED}Binary not found in archive${NC}"
        ls -la "$tmp_dir"
        exit 1
    fi
fi

chmod 755 "$install_tmp"
mv -f "$install_tmp" "$INSTALL_DIR/$binary_name"
echo -e "${GREEN}✓ Downloaded and installed${NC}"

echo -e "${GREEN}✓ Installed to: $INSTALL_DIR${NC}"

if "$INSTALL_DIR/$binary_name" --version >/dev/null 2>&1; then
    echo -e "${GREEN}✓ Binary verified: $("$INSTALL_DIR/$binary_name" --version 2>/dev/null)${NC}"
else
    echo -e "${ORANGE}Warning: could not verify binary${NC}"
fi

add_to_path() {
    local config_file=$1
    local command=$2
    if grep -Fxq "$command" "$config_file" 2>/dev/null; then
        return
    fi
    if [ -w "$config_file" ]; then
        echo "" >> "$config_file"
        echo "# Codey CLI" >> "$config_file"
        echo "$command" >> "$config_file"
        echo -e "${GREEN}✓ Added to PATH in $config_file${NC}"
    fi
}

if [ "$NO_MODIFY_PATH" != "true" ]; then
    case ":${PATH}:" in
        *:"${INSTALL_DIR}":*) ;;
        *)
            current_shell=$(basename "${SHELL:-bash}")
            config_candidates=()
            case "$current_shell" in
                fish) config_candidates=("$HOME/.config/fish/config.fish") ;;
                zsh)  config_candidates=("${ZDOTDIR:-$HOME}/.zshrc") ;;
                bash) config_candidates=("$HOME/.bashrc" "$HOME/.bash_profile") ;;
                *)    config_candidates=("$HOME/.profile") ;;
            esac

            found=false
            for file in "${config_candidates[@]}"; do
                if [ -f "$file" ]; then
                    case "$current_shell" in
                        fish) add_to_path "$file" "fish_add_path $INSTALL_DIR" ;;
                        *)    add_to_path "$file" "export PATH=\"$INSTALL_DIR:\$PATH\"" ;;
                    esac
                    found=true
                    break
                fi
            done

            if [ "$found" = false ]; then
                echo -e "${ORANGE}Could not find a shell config. Add to PATH manually:${NC}"
                echo -e "  export PATH=\"$INSTALL_DIR:\$PATH\""
            fi

            if [ "$os" = "windows" ]; then
                echo -e "${MUTED}For PowerShell/cmd, add to your user PATH:${NC}"
                echo -e "  $INSTALL_DIR"
            fi
            ;;
    esac
fi

echo ""
echo -e "${GREEN}Codey CLI installed!${NC}"
echo ""
echo -e "Run ${GREEN}codey${NC} in any project directory to start."
echo -e "${MUTED}Check for updates anytime with: codey upgrade --check${NC}"
echo ""

if [ -n "${GITHUB_ACTIONS:-}" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
fi
